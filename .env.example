# ═══════════════════════════════════════════════════════════════════════════
# Kwik Environment Variables
# ═══════════════════════════════════════════════════════════════════════════
#
# Copy this file to .env.local for local development.
# For production, this file lives at /opt/kwik/shared/.env
#
# ═══════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────
# Redis Configuration
# ─────────────────────────────────────────────────────────────
# Connection URL for Redis (metadata storage, stats, expiry tracking)
REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────────────────────────
# S3-Compatible Storage Configuration
# ─────────────────────────────────────────────────────────────
# Works with MinIO (local/self-hosted), AWS S3, Cloudflare R2, etc.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=kwik-files

# ─────────────────────────────────────────────────────────────
# Application Configuration
# ─────────────────────────────────────────────────────────────
# Base URL for generating shareable links
# In production, this should be your domain (e.g., https://kwik.gg)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Maximum file size in bytes (default: 100MB)
MAX_FILE_SIZE=104857600

# Maximum expiry time in seconds (default: 7 days)
MAX_EXPIRY_SECONDS=604800
